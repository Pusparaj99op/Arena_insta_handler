# Secrets. Never commit these.
automation/.env
.env
*.pem
*.key

# Runtime state. The queue is precious, but it is local: a repo is not a database,
# and a merge conflict in queue.json loses a week of approved work.
state/*
!state/.gitkeep

# Rendered media. Regenerable from the spec, and large.
# Scoped to the output dirs on purpose: the skill pack ships its own sound
# effects and fonts under .claude/, and a blanket *.wav would silently drop them.
build/*
!build/.gitkeep
!build/publish/
build/publish/*
!build/publish/.gitkeep
/state/*.ass
/state/*.srt
/examples/out/
*.tmp.mp4
*.tmp.wav

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Node (only if a Remotion/HyperFrames project is added)
node_modules/
.npm/
pnpm-store/
yarn-error.log
package-lock.json.bak

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local scratch: notes that are not ready to be content
scratch/
drafts/

# Reports generated by tools (contrast checks, site checks, render logs)
reports/
*.report.json
