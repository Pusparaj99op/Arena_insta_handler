# ---------------------------------------------------------------------------
# Copy to automation/.env and fill in. Never commit .env: it holds the token
# that controls a real account.
#
#   cp automation/.env.example automation/.env
#   chmod 600 automation/.env
# ---------------------------------------------------------------------------

# --- The account -----------------------------------------------------------
# Instagram professional account id (not the username). `python3 -m ig whoami`
# prints it once the token works.
IG_USER_ID=
# Long-lived (60 day) token. Short-lived tokens expire mid-campaign.
IG_ACCESS_TOKEN=
# Used to verify every webhook POST. Without it, every event is rejected.
META_APP_SECRET=
# Our own random string, echoed back by Meta during webhook setup.
#   openssl rand -hex 16
IG_WEBHOOK_VERIFY_TOKEN=
# The handle, used in disclosures ("@you's automated assistant").
IG_HANDLE=

# --- Media hosting ---------------------------------------------------------
# Meta fetches media by URL. This must serve build/publish/ over HTTPS.
# Nothing outside build/publish/ is ever addressed.
PUBLIC_MEDIA_BASE_URL=

# --- The model that answers DMs -------------------------------------------
# Any OpenAI-compatible endpoint works. Leave OPENAI_API_KEY empty and the
# agent still drafts through the Claude skills, but it cannot answer a DM
# inside the 24-hour window.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1     # or Groq, Together, Ollama, vLLM
# LLM_API_KEY=                                  # if the endpoint is not OpenAI

# --- Voiceover -------------------------------------------------------------
# elevenlabs | openai | local    (auto-detected if empty, in that order)
VOICE_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# How the automated voice reads. This is direction, not prose.
VOICE_DIRECTION=Speak like a calm finance teacher talking to one person. Measured pace, short pauses at commas, no radio-host energy, no upward inflection at the end of statements.
# For local TTS:
# PIPER_MODEL=/path/to/en_US-voice.onnx

# --- Transcription (captions) ---------------------------------------------
# Local whisper first, then the API. Word timings only; estimated timings
# are how automated accounts get spotted.
WHISPER_MODEL=small

# --- Policy: the three switches -------------------------------------------
# All off by default. Turn them on in this order, after watching what the
# agent would have said: AUTOSEND_DMS (keyword deliveries only), then
# AUTOPUBLISH, then AUTOCREATE_COMMENTS last.
AUTOPUBLISH=off
AUTOSEND_DMS=off
AUTOCREATE_COMMENTS=off
# Below this the model's draft goes to a human instead of sending.
MIN_CONFIDENCE=0.72

# --- Limits: headroom under Meta's ceilings -------------------------------
# Publishing: Meta allows 100/24h. 8 is a credibility limit, not a technical
# one: a fintech account posting 30 times a day is a content farm.
LIMIT_POSTS_24H=8
# Private replies: Meta allows 750/hour. A human cannot approve more than 60.
LIMIT_PRIVATE_REPLIES_HOUR=60
LIMIT_COMMENT_REPLIES_HOUR=30
# Minimum gap between API calls, seconds. Politeness, not a requirement.
IG_MIN_CALL_INTERVAL=0.35

# --- Uncomment only if you use a Facebook-Login app with a linked Page ------
# IG_GRAPH_HOST=https://graph.facebook.com
IG_GRAPH_VERSION=v23.0

# --- Telegram alerts (optional) -------------------------------------------
# Get a message when a publish fails or something needs a human.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
